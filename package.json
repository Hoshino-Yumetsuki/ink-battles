{
  "name": "ink-battles",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "yarn build:worker && wrangler dev --local --assets dist/client",
    "dev:client": "vite",
    "dev:worker": "yarn build:worker && wrangler dev --local",
    "build": "yarn build:client && yarn build:worker && yarn build:server",
    "build:client": "vite build",
    "build:worker": "node -e \"const fs=require('fs');fs.rmSync('dist/worker',{recursive:true,force:true});fs.rmSync('.wrangler/deploy/config.json',{force:true})\" && rolldown -c rolldown.config.js",
    "build:server": "node -e \"const fs=require('fs');fs.rmSync('dist/server',{recursive:true,force:true})\" && rolldown -c rolldown.server.config.js",
    "start": "node dist/server/index.js",
    "preview": "yarn build && wrangler dev --local",
    "deploy": "yarn build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix && oxfmt",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@cap.js/server": "^4.0.5",
    "@cap.js/widget": "^0.1.57",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sinclair/typebox": "^0.34.52",
    "@valibot/to-json-schema": "^1.7.1",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "chardet": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "^3.22.1",
    "elysia": "^1.4.30",
    "file-type": "^22.0.2",
    "framer-motion": "^13.2.0",
    "geist": "^1.7.2",
    "iconv-lite": "^0.7.3",
    "jose": "^6.2.11",
    "lucide-react": "^1.41.0",
    "mammoth": "^1.12.2",
    "mermaid": "^11.17.2",
    "mongo-sanitize": "^1.1.0",
    "mongodb": "^7.6.0",
    "nodemailer": "^10.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sonner": "^2.0.8",
    "sury": "^11.0.0-rc.2",
    "tailwind-merge": "^3.6.0",
    "unified": "^11.0.5",
    "valibot": "^1.4.2",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0",
    "xsai": "^0.5.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@rolldown/plugin-node-polyfills": "^1.0.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mongo-sanitize": "^1.0.3",
    "@types/mongodb": "^4.0.7",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "node-addon-api": "^8.9.2",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react-tabs": "^6.1.1",
    "rolldown": "^1.2.7",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.129.0"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
  "type": "module"
}
